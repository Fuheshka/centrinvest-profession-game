  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0422\u0438\u043F \u0441\u043B\u0435\u0432\u0430 \u2013 \u0437\u0430\u043C\u0435\u0442\u043A\u0430 \u043D\u0430 \u0434\u043E\u0441\u043A\u0435. \u041D\u0430\u0436\u043C\u0438 \u0437\u0430\u043C\u0435\u0442\u043A\u0443 \u2013 \u0432\u044B\u0431\u0435\u0440\u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440, \u0442\u044F\u043D\u0438 \u2013 \u0434\u0432\u0438\u0433\u0430\u0439. \xAB\u0421\u0432\u044F\u0437\u0430\u0442\u044C \u0431\u043B\u043E\u043A\u0438\xBB, \u0437\u0430\u0442\u0435\u043C \u0434\u0432\u0435 \u0437\u0430\u043C\u0435\u0442\u043A\u0438 \u2013 \u043B\u0438\u043D\u0438\u044F, \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0448\u0435\u0441\u0442\u0438. \u041C\u0435\u0442\u043A\u0430 \u043D\u0430 \u043B\u0438\u043D\u0438\u0438: \u0414 \u2013 \u0434\u0438\u0437\u0430\u0439\u043D, \u041C \u2013 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438, \u0417 \u2013 \u0437\u0432\u0443\u043A, \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u043F\u043B\u044E\u0441, \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043C\u0438\u043D\u0443\u0441. \u0418\u0442\u043E\u0433 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043B\u0438\u043D\u0438\u044F\u043C."
