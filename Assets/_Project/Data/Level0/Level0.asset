  id: level0
  title: "0 \xB7 \u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
  briefText: "{name}, \u043F\u0440\u0438\u0432\u0435\u0442! \u0423 \u043D\u0430\u0441 \u0437\u0430\u043A\u0430\u0437 \u043E\u0442 \u0431\u0430\u043D\u043A\u0430 \xAB\u042E\u0436\u043D\u044B\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043B\xBB: \u0438\u0433\u0440\u0430 \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0434\u043B\u044F \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u0432 12+. \u0421\u0440\u043E\u043A \u2013 {days} \u0434\u043D\u044F, \u0431\u044E\u0434\u0436\u0435\u0442 \u2013 {budget}. \u041D\u0443\u0436\u043D\u0430 \u043E\u0446\u0435\u043D\u043A\u0430 70 \u0438\u043B\u0438 \u0432\u044B\u0448\u0435.\n\n\u0421\u043E\u0431\u0435\u0440\u0438 \u043A\u043E\u043D\u0446\u0435\u043F\u0442 \u043D\u0430 \u0434\u044D\u0448\u0431\u043E\u0440\u0434\u0435: \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0448\u0435\u0441\u0442\u044C \u0431\u043B\u043E\u043A\u043E\u0432, \u0432\u044B\u0431\u0435\u0440\u0438 \u0432 \u043A\u0430\u0436\u0434\u043E\u043C \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0438 \u0438\u0445 \u043B\u0438\u043D\u0438\u044F\u043C\u0438. \u0417\u0435\u043B\u0451\u043D\u0430\u044F \u043B\u0438\u043D\u0438\u044F \u2013 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0438\u0433\u0440\u0435."
  deadlineDays: 3
  startBudget: 100000
  passScore: 70
