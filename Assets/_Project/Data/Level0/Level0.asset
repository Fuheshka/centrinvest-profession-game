  texts:
  - key: approved
    text: "\u041A\u043E\u043D\u0446\u0435\u043F\u0442 \u043F\u0440\u0438\u043D\u044F\u0442. \u0422\u0435\u043F\u0435\u0440\u044C \u0445\u0435\u0434\u0445\u0430\u043D\u0442\u0435\u0440: \u043D\u0430\u0439\u043C\u0438 \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u0434\u0438\u0437\u0430\u0439\u043D, \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438 \u0438 \u0437\u0432\u0443\u043A, \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0437\u0434\u0430\u0439 \u0437\u0430\u0434\u0430\u0447\u0438 \u0432 \u0442\u0430\u0441\u043A-\u043B\u0438\u0441\u0442\u0435. \u0421 \u044D\u0442\u043E\u0439 \u043C\u0438\u043D\u0443\u0442\u044B \u043F\u043E\u0448\u0451\u043B \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u0434\u0435\u043D\u044C \u2013 5 \u043C\u0438\u043D\u0443\u0442."
  - key: morning
    text: "\u0423\u0442\u0440\u043E, \u0434\u0435\u043D\u044C {day}. \u0414\u043E \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u0430 \u0434\u043D\u0435\u0439: {left}. \u0423\u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u043B\u0438 \u2013 \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0437\u0430\u0434\u0430\u0447\u0438."
  - key: last_day
    text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0434\u0435\u043D\u044C! \u0421\u043E\u0431\u0435\u0440\u0438 \u0438\u0433\u0440\u0443 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0434\u043D\u044F, \u0438\u043D\u0430\u0447\u0435 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0443 \u043D\u0435\u0447\u0435\u0433\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C."
  - key: passed
    text: "\xAB\u042E\u0436\u043D\u044B\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043B\xBB \u043F\u0440\u0438\u043D\u044F\u043B \u0438\u0433\u0440\u0443. \u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D!"
  - key: rework
    text: "\u041D\u0438\u0436\u0435 70 \u2013 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u0442. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u0441\u043B\u0430\u0431\u044B\u0439 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0438 \u043E\u0442\u0434\u0430\u0439 \u0444\u0430\u0439\u043B \u043D\u0430 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
  - key: deadline_fail
    text: "\u0421\u0440\u043E\u043A \u0432\u044B\u0448\u0435\u043B, \u0430 \u0438\u0433\u0440\u044B \u0441 \u043E\u0446\u0435\u043D\u043A\u043E\u0439 70+ \u043D\u0435\u0442. \u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D."
  - key: budget_fail
    text: "\u0414\u0435\u043D\u044C\u0433\u0438 \u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C: \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0435 \u043D\u0435\u0447\u0435\u043C. \u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D."
  - key: hello_lera
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u044F \u041B\u0435\u0440\u0430, \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u0446\u0430. \u0420\u0438\u0441\u0443\u044E \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E, \u043D\u043E \u043D\u0435 \u0431\u044B\u0441\u0442\u0440\u043E."
  - key: hello_vika
    text: "\u0425\u0430\u0439! \u0412\u0438\u043A\u0430, \u0430\u0440\u0442. \u0414\u0435\u043B\u0430\u044E \u043E\u0447\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E, \u043F\u043E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u2013 \u043A\u0430\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F."
  - key: hello_kostya
    text: "\u041A\u043E\u0441\u0442\u044F, \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442. \u0421\u0440\u0435\u0434\u043D\u0435 \u043F\u043E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0443."
  - key: hello_dima
    text: "\u0414\u0438\u043C\u0430, \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0437\u0430\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0431\u0430\u0433\u043E\u0432."
  - key: hello_anya
    text: "\u0410\u043D\u044F, \u0437\u0432\u0443\u043A. \u0411\u044B\u0441\u0442\u0440\u043E \u0438 \u0445\u043E\u0440\u043E\u0448\u043E, \u043D\u043E \u0438 \u0441\u0442\u043E\u044E \u043D\u0435\u0434\u0451\u0448\u0435\u0432\u043E."
  - key: hello_gosha
    text: "\u0413\u043E\u0448\u0430, \u0437\u0432\u0443\u043A. \u041D\u0435\u0434\u043E\u0440\u043E\u0433\u043E, \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E, \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E."
  events:
  - id: ref
    d: 0
    anyone: 0
