# Unity (based on github/gitignore Unity.gitignore)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/
*.log

# Autogenerated IDE files
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties
mono_crash.*.json

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables / StreamingAssets
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity autosave recovery scenes and temp test folders
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
/[Aa]ssets/Temp/
/[Aa]ssets/Temp.meta

# Temporary screenshots from agents
/[Aa]ssets/Screenshots/*
!/[Aa]ssets/Screenshots/.gitkeep
/screenshots/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Secrets
.env
.env.*

# Local agent configs
.agents/
.claude/*
!.claude/settings.json
.trace-mcp/
.gamemaker/

# unlazy skill working files
/GATES.md
.unlazy/
.unlazy-hook-state.json

# Progress timelapses (rebuild with tools/progress.py build)
/docs/progress/_out/

# Obsidian vault settings (per user)
docs/.obsidian/

# oh-my-claudecode runtime state (project skills stay committable)
/.omc/*
!/.omc/skills/
